<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include user bookmarks, preferences, and progress -->
        <include domain="database" path="quran_database" />
        <include domain="database" path="umrah_database" />
        <include domain="database" path="notification_database" />
        <include domain="sharedpref" path="." />

        <!-- Exclude large preloaded static databases from cloud backup -->
        <exclude domain="database" path="offline_quran_database_v13" />
        <exclude domain="database" path="offline_quran_database_v13-shm" />
        <exclude domain="database" path="offline_quran_database_v13-wal" />
        <exclude domain="database" path="quran_wbw.db" />
        <exclude domain="database" path="quran_wbw.db-shm" />
        <exclude domain="database" path="quran_wbw.db-wal" />
        <exclude domain="database" path="quran.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="quran_database" />
        <include domain="database" path="umrah_database" />
        <include domain="database" path="notification_database" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
